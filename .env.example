# Copiar este archivo como .env y completar las credenciales locales.
# .env contiene secretos y no se publica en Git.
DBT_PG_HOST=localhost
DBT_PG_PORT=5432
DBT_PG_USER=
DBT_ENV_SECRET_PG_PASSWORD=''

# Base de trabajo: originales en public y vistas limpias en staging.
DBT_PG_DBNAME=dunnhumby_etl
DBT_PG_SCHEMA=staging
DBT_TARGET=dev
DBT_PG_TYPE=postgres
DBT_THREADS=4
DBT_PG_CONNECT_TIMEOUT=10

